# 배포 환경변수 샘플. 실제 값은 .env에 넣는다.
#
# 이 파일(.env.example)은 Git에 올라간다. 실제 값을 여기에 적지 않는다.
# 비밀값이 들어가는 곳은 .env 하나뿐이고, .gitignore가 .env를 막는다.
#
# 쓰는 곳은 src/main/resources/application-prod.yml 이다.
# 쓰는 제공처는 둘 다 무료 한도 안이다 - Supabase(DB), Cloudflare Workers AI(답변+임베딩).
# OpenRouter는 쓰지 않는다. 아래 2번 참조.

# ---------------------------------------------------------------------------
# 1. Supabase - PostgreSQL + pgvector. 무료 티어.
# ---------------------------------------------------------------------------
# 호스트는 세션 풀러를 쓴다. 대시보드 Connect -> Session pooler의 값을 복사한다.
# 직접 연결(db.<ref>.supabase.co)은 AAAA 레코드만 있어 IPv4 환경에서 붙지 않고,
# 트랜잭션 풀러(6543)는 prepared statement를 못 써서 JDBC에 맞지 않는다.
# 세션 풀러는 5432이고 IPv4이며 prepared statement를 지원한다.
#
# 사용자명이 postgres 가 아니라 postgres.<project-ref> 다. 직접 연결과 다르다.
# Supabase가 주는 JDBC 문자열에는 자격증명이 ?user=&password= 로 박혀 있으니
# 호스트만 떼어 오고 ?sslmode=require 를 붙인다.
DB_URL=jdbc:postgresql://aws-<n>-<리전>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<비밀번호>

# psql 로 직접 붙을 때 쓰는 형태. JDBC URL과 달리 postgresql:// 로 시작한다.
# 비밀번호에 @ : / ? # 가 있으면 퍼센트 인코딩해야 한다(@ 는 %40). 안 그러면 libpq가
# 마지막 @ 를 호스트 구분자로 봐서 비밀번호가 잘린 채 전송되고 인증이 실패한다.
PG_URL=postgresql://postgres.<project-ref>:<퍼센트 인코딩한 비밀번호>@aws-<n>-<리전>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# 2. OpenRouter - 지금은 쓰지 않는다. 예비.
# ---------------------------------------------------------------------------
# 답변도 Cloudflare로 받기로 해서 application-prod.yml이 이 값을 참조하지 않는다.
# 옮긴 이유는 두 가지다. (1) 무료 모델 일일 상한이 50건이다(/api/v1/key로 확인).
# (2) 공용 풀 혼잡으로 temporarily rate-limited upstream 429가 잦다.
# 다시 쓸 일이 생기면 키 형식은 sk-or-v1- + 16진수 64자이고, 발급할 때
# 만료(TTL) 칸을 반드시 비워 둔다 - 만료가 붙으면 그 시각에 401로 죽는다(겪었다).
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# 3. Cloudflare Workers AI - 답변과 임베딩을 모두 담당한다.
# ---------------------------------------------------------------------------
# 답변  @cf/meta/llama-3.3-70b-instruct-fp8-fast (질문 1건에 약 32~97뉴런, 하루 100건 이상)
# 임베딩 @cf/baai/bge-m3 - 로컬 Ollama와 같은 모델이라 819청크와 1024차원을 그대로 쓴다.
# 무료 한도는 하루 10,000 뉴런이고 bge-m3는 100만 입력토큰에 1,075 뉴런이다.
#
# CF_ACCOUNT_ID: dash.cloudflare.com 의 Account ID (16진수 32자).
#                application-prod.yml의 base-url 경로에 들어간다.
# CF_API_TOKEN : My Profile -> API Tokens -> Create Token.
#                Workers AI 템플릿을 쓰는 게 제일 쉽다. Custom token으로 만들 때는
#                권한이 Workers AI - Read 와 Workers AI - Edit 두 줄 다 필요하다.
#                추론이 POST라서 Read만 있으면 호출이 403으로 막힌다.
#                계정 이메일 인증을 끝내야 토큰 생성이 된다. 안 하면 생성 버튼이
#                "An unknown error occurred"로 떨어지고 진짜 사유는 그 밑줄에 있다.
CF_ACCOUNT_ID=<16진수 32자>
CF_API_TOKEN=<토큰>
